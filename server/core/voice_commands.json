{
  "version": 1,
  "commands": [
    {
      "service": "server",
      "feature": "lights",
      "id": "power_on",
      "patterns": [
        {
          "label": "complete power-on request",
          "mode": "fullmatch",
          "fast_path": true,
          "examples": [
            "lights on",
            "turn on the lights"
          ],
          "regex": "(?:turn|switch)?\\s*(?:the\\s+)?(?:lights?|bulbs?|spots?)\\s+on|(?:turn|switch)\\s+on\\s+(?:the\\s+)?(?:lights?|bulbs?|spots?)"
        }
      ]
    },
    {
      "service": "server",
      "feature": "lights",
      "id": "power_off",
      "patterns": [
        {
          "label": "complete power-off request",
          "mode": "fullmatch",
          "fast_path": true,
          "examples": [
            "lights off",
            "turn off the lights"
          ],
          "regex": "(?:turn|switch)?\\s*(?:the\\s+)?(?:lights?|bulbs?|spots?)\\s+off|(?:turn|switch)\\s+off\\s+(?:the\\s+)?(?:lights?|bulbs?|spots?)"
        }
      ]
    },
    {
      "service": "server",
      "feature": "lights",
      "id": "brightness",
      "patterns": [
        {
          "label": "legacy brightness extraction",
          "mode": "search",
          "regex": "(?:lights?|bulbs?|spots?).*?(\\d{1,3})\\s*(?:%|percent)"
        },
        {
          "label": "complete brightness request",
          "mode": "fullmatch",
          "fast_path": true,
          "examples": [
            "lights 1%",
            "lights 100 percent"
          ],
          "regex": "(?:(?:set|make|dim)\\s+)?(?:the\\s+)?(?:lights?|bulbs?|spots?)\\s+(?:to\\s+)?(?:[1-9]|[1-9]\\d|100)\\s*(?:%|percent)"
        }
      ]
    },
    {
      "service": "server",
      "feature": "lights",
      "id": "color",
      "target_words": [
        "light",
        "lights",
        "bulb",
        "bulbs",
        "spot",
        "spots"
      ],
      "colors": [
        "red",
        "green",
        "blue",
        "white",
        "yellow",
        "orange",
        "purple",
        "pink",
        "cyan"
      ],
      "patterns": [
        {
          "label": "complete color request",
          "mode": "fullmatch",
          "fast_path": true,
          "examples": [
            "make the lights blue",
            "set the lights to red"
          ],
          "regex": "(?:(?:make|set|turn)\\s+(?:the\\s+)?(?:lights?|bulbs?|spots?)\\s+(?:to\\s+)?)(?:blue|cyan|green|orange|pink|purple|red|white|yellow)"
        }
      ]
    },
    {
      "service": "server",
      "feature": "light_targets",
      "id": "set_power",
      "patterns": [
        {
          "label": "state before named light or group",
          "mode": "fullmatch",
          "fast_path": true,
          "examples": [
            "turn off the mirror",
            "turn on the mushroom lamp",
            "switch off the lamp plug",
            "turn on the govee",
            "turn on the small lights",
            "turn off the smart life lights",
            "turn on all lights"
          ],
          "regex": "(?:turn|switch) (?P<state>on|off) (?:the )?(?P<target>lamp|mirror|mushroom|govee|tuya|small|smart life|all)(?: lamp| lights?| plugs?)?"
        },
        {
          "label": "state after named light or group",
          "mode": "fullmatch",
          "fast_path": true,
          "examples": [
            "mirror off",
            "turn the mushroom lamp on",
            "switch the small lights off",
            "set the lamp to on",
            "all lights off"
          ],
          "regex": "(?:(?:turn|switch|set) )?(?:the )?(?P<target>lamp|mirror|mushroom|govee|tuya|small|smart life|all)(?: lamp| lights?| plugs?)? (?:to )?(?P<state>on|off)"
        }
      ]
    },
    {
      "service": "server",
      "feature": "plugs",
      "id": "get_state",
      "patterns": [
        {
          "label": "named plug state question",
          "mode": "fullmatch",
          "fast_path": true,
          "examples": [
            "is the lamp plug on",
            "is the mirror off",
            "is the mushroom lamp on",
            "is the mirror light on"
          ],
          "regex": "is (?:the )?(?P<plug>lamp|mirror|mushroom)(?: lamp| light| plug)? (?:on|off)"
        },
        {
          "label": "named plug status request",
          "mode": "fullmatch",
          "fast_path": true,
          "examples": [
            "check the lamp plug",
            "status of the mirror",
            "what is the state of the mushroom lamp"
          ],
          "regex": "(?:check|status of|what is the state of|what's the state of) (?:the )?(?P<plug>lamp|mirror|mushroom)(?: lamp| light| plug)?"
        }
      ]
    },
