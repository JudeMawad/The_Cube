# Export edited settings in the AI-node launch environment.
CUBE_AI_WHISPER_MODEL=base.en
CUBE_AI_WHISPER_DEVICE=cuda
CUBE_AI_WHISPER_COMPUTE_TYPE=float16
CUBE_AI_LLM_BASE_URL=http://YOUR_LLM_HOST:1234/v1
CUBE_AI_LLM_MODEL=YOUR_INSTALLED_MODEL
CUBE_AI_LLM_TIMEOUT=20
