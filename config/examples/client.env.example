# Copy to ~/.config/cube/client.env; edit for this Pi. No dotenv auto-loader.
CUBE_CLIENT_ID=cube
CUBE_CAPTURE_DEVICE=plughw:0,0
CUBE_VOICE_ENDPOINT=http://YOUR_BACKEND_HOST:8765/voice
CUBE_TTS_ENDPOINT=http://YOUR_BACKEND_HOST:8765/tts
# Set your preferred forecast location; unedited placeholders disable weather.
CUBE_WEATHER_LATITUDE=YOUR_LATITUDE
CUBE_WEATHER_LONGITUDE=YOUR_LONGITUDE
CUBE_WEATHER_TIMEZONE=YOUR_TIMEZONE
CUBE_WEATHER_REFRESH_SECONDS=600
# CUBE_SPEAKER_MAC=YOUR_PAIRED_DEVICE_MAC
# CUBE_WAKE_MODEL_PATH=assets/models/hey_cube.onnx
# CUBE_PIPER_VOICE_PATH=assets/voices/en_US-lessac-medium.onnx
