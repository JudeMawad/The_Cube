# Copy to ~/.config/cube/server.env. Blank disables the optional AI node.
CUBE_AI_NODE_URL=
CUBE_AI_TRANSCRIPTION_TIMEOUT=1
CUBE_AI_PROCESS_TIMEOUT=10
CUBE_WHISPER_MODEL=base.en
# CUBE_WHISPER_CACHE_DIR=assets/models/whisper
# CUBE_KOKORO_MODEL_PATH=assets/models/kokoro/kokoro-v1.0.onnx
# CUBE_KOKORO_VOICES_PATH=assets/models/kokoro/voices-v1.0.bin
# Opt-in private diagnostic only: CUBE_LOG_TRANSCRIPTS=1
